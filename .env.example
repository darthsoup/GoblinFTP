# GoblinFTP environment variables - generated by 'just confgen', documented in
# docs/configuration.md. Values are commented out and show the built-in default;
# docker compose loads this file via env_file, so an uncommented line is live.

# ── Server ────────────────────────────────────────────────────────────────────
#GFTP_PORT=8080
#GFTP_DATA_DIR=/app/data

# ── UI ────────────────────────────────────────────────────────────────────────
#GFTP_LANGUAGE=en
#GFTP_UI_PAGE_TITLE=
#GFTP_UI_SHOW_DOT_FILES=false
#GFTP_UI_SHOW_NAVIGATION_HISTORY=true

# ── Editor ────────────────────────────────────────────────────────────────────
#GFTP_EDITOR_ALLOWED_EXTENSIONS=html,htm,xhtml,css,scss,sass,less,js,mjs,cjs,jsx,ts,tsx,vue,svelte,php,phtml,py,rb,go,rs,java,c,h,cpp,hpp,sh,bash,zsh,pl,lua,json,json5,xml,svg,yaml,yml,toml,ini,conf,cfg,env,properties,sql,csv,tsv,txt,md,markdown,rst,log,htaccess,htpasswd,gitignore,editorconfig,twig,ejs,hbs,mustache,liquid,erb,j2
#GFTP_EDITOR_DISABLED=false
#GFTP_EDITOR_VIEW_ONLY=false

# ── Connections and TLS ───────────────────────────────────────────────────────
#GFTP_CONNECTION_ALLOWED_TYPES=ftp,ftps,sftp
#GFTP_CONNECTION_DISABLE_CHMOD=false
#GFTP_CONNECTION_PRESET_HOST=
#GFTP_CONNECTION_PRESET_PORT=
#GFTP_CONNECTION_LOCK_HOST=false
#GFTP_CONNECTION_PASSIVE_MODE=true
#GFTP_CONNECTION_FTP_TLS_INSECURE_SKIP_VERIFY=false

# ── Access ────────────────────────────────────────────────────────────────────
#GFTP_ACCESS_ALLOWED_CLIENT_ADDRESSES=

# ── White-label branding ──────────────────────────────────────────────────────
#GFTP_BRANDING_APP_NAME=GoblinFTP
#GFTP_BRANDING_LOGO_URL=
#GFTP_BRANDING_LOGO_DARK_URL=
#GFTP_BRANDING_FAVICON_URL=
#GFTP_BRANDING_PRIMARY_COLOR=
#GFTP_BRANDING_PRIMARY_TEXT_COLOR=
#GFTP_BRANDING_HIDE_ATTRIBUTION=false

# ── Iframe embedding ──────────────────────────────────────────────────────────
#GFTP_FRAME_ANCESTORS=
#GFTP_EMBED_CHROMELESS=auto

# ── Secrets ───────────────────────────────────────────────────────────────────
#GFTP_SESSION_SECRET=
#GFTP_DOWNLOAD_TOKEN_SECRET=

# ── Login and sessions ────────────────────────────────────────────────────────
#GFTP_SESSION_TTL_SECONDS=7200
#GFTP_LOGIN_MAX_ATTEMPTS=5
#GFTP_LOGIN_COOLDOWN_SECONDS=300
#GFTP_LOGIN_FORM_DISABLED=false

# ── SSO login links ───────────────────────────────────────────────────────────
#GFTP_SSO_ENABLED=false
#GFTP_SSO_SECRET=

# ── Uploads and chunking ──────────────────────────────────────────────────────
#GFTP_UPLOAD_CHUNK_SIZE=5242880
#GFTP_UPLOAD_MAX_CONCURRENT=1

# ── Logging ───────────────────────────────────────────────────────────────────
#GFTP_LOG_LEVEL=info
#GFTP_LOG_FORMAT=json
#GFTP_LOG_FILE=
#GFTP_LOG_FILE_MAX_SIZE_MB=10
#GFTP_LOG_FILE_MAX_BACKUPS=5
#GFTP_LOG_FILE_MAX_AGE_DAYS=0
#GFTP_LOG_FRONTEND=true

# ── Metrics ───────────────────────────────────────────────────────────────────
#GFTP_METRICS_ENABLED=false
#GFTP_METRICS_PORT=9091

# ── Error tracking (Sentry) ───────────────────────────────────────────────────
#GFTP_SENTRY_DSN=
#GFTP_SENTRY_ENVIRONMENT=
#GFTP_SENTRY_RELEASE=
#GFTP_SENTRY_SAMPLE_RATE=0

# ── S3 chunk staging ──────────────────────────────────────────────────────────
#GFTP_S3_ENABLED=false
#GFTP_S3_ENDPOINT=
#GFTP_S3_BUCKET=
#GFTP_S3_REGION=us-east-1
#GFTP_S3_ACCESS_KEY=
#GFTP_S3_SECRET_KEY=
#GFTP_S3_USE_PATH_STYLE=true
#GFTP_S3_PREFIX=gftp-uploads
#GFTP_S3_TIMEOUT_SECONDS=60

# ── Dev & testing (hand-maintained tail) ──────────────────────────────────────
# GFTP_VERSION pins the docker-compose.prod.yml image tag; GFTP_DEV_PROXY is the
# vite proxy target; NUXT_PUBLIC_SENTRY_DSN is baked into the SPA at build time.
#GFTP_VERSION=
#GFTP_DEV_PROXY=http://localhost:8080
#NUXT_PUBLIC_SENTRY_DSN=

# Integration-test gates and test-server credentials (compose profile "testing").
#GFTP_TEST_FTP_HOST=localhost:21
#GFTP_TEST_FTPS_HOST=localhost:2121
#GFTP_TEST_SFTP_HOST=localhost:2222
#GFTP_TEST_S3_ENDPOINT=http://localhost:9000
#FTP_USER=ftpuser
#FTP_PASS=ftppass
#SFTP_USER=ftpuser
#SFTP_PASS=ftppass
#PUBLIC_IP=127.0.0.1

# MinIO test-server root credentials, deliberately separate from GFTP_S3_*.
#MINIO_ROOT_USER=minioadmin
#MINIO_ROOT_PASSWORD=minioadmin
#MINIO_TEST_BUCKET=gftp-chunks
