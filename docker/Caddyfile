{
	# Believe X-Forwarded-* only from the ranges the operator declared, matching
	# GFTP_ACCESS_TRUSTED_PROXIES on the Go side. Both must agree: Caddy decides
	# what reaches the backend, the backend decides what it believes. Empty (the
	# default) trusts nothing, so a client cannot spoof its own address.
	# entrypoint.sh derives the space-separated form Caddy wants from the
	# comma-separated GFTP_ACCESS_TRUSTED_PROXIES.
	servers {
		trusted_proxies static {$GFTP_CADDY_TRUSTED_PROXIES:}
		trusted_proxies_strict
	}
}

:80 {
	encode zstd gzip

	@sso {
		path /
		query sso=*
	}

	# API requests → Go binary
	handle /api/* {
		reverse_proxy localhost:8080
	}

	# Health check → Go binary
	handle /healthz {
		reverse_proxy localhost:8080
	}

	# Per-tenant white-label theme assets → Go binary (validates + serves from the data dir)
	handle /themes/* {
		reverse_proxy localhost:8080
	}

	# SSO entry point → Go binary (must intercept before SPA fallback)
	handle @sso {
		reverse_proxy localhost:8080
	}

	# Content-hashed build output: the filename changes whenever the bytes do,
	# so it can be cached indefinitely.
	@immutable path /_nuxt/*
	handle @immutable {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /app/public
		file_server
	}

	# All other requests → Nuxt SPA with HTML5 history fallback
	handle {
		# frame-ancestors is only honoured on the response carrying the framed
		# document, and that document is served here, not by the Go binary.
		# Same env var the backend reads and validates; entrypoint.sh starts
		# Caddy only after /healthz passes, so a malformed value kills the
		# container before it can ever reach a served header.
		#
		# Scoped to this block on purpose: at site level it would add a second
		# Content-Security-Policy to the Go-proxied responses, and browsers
		# enforce the intersection of both - correct, but very hard to debug.
		#
		# Only frame-ancestors here. The generated index.html carries inline
		# <script> blocks and an importmap, so a document-level script-src
		# 'self' would white-screen the app.
		header Content-Security-Policy "frame-ancestors {$GFTP_FRAME_ANCESTORS:'none'}"
		# Mirrors the headers the Go binary sets on its own responses.
		header X-Content-Type-Options "nosniff"
		header Referrer-Policy "no-referrer"
		header Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# index.html must never be cached: it names the hashed chunks, so a
		# stale copy points at files that no longer exist after an upgrade -
		# a white screen rather than an old-but-working app.
		header Cache-Control "no-cache"

		root * /app/public
		try_files {path} /index.html
		file_server
	}
}
