{
	admin off
	persist_config off
	# Only external proxies belong here; the internal hop is trusted separately by Go.
	servers {
		trusted_proxies static {$GFTP_CADDY_TRUSTED_PROXIES:}
		trusted_proxies_strict
	}
}

:8080 {
	encode zstd gzip

	@sso {
		path /
		query sso=*
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8081 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /healthz {
		reverse_proxy 127.0.0.1:8081 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Theme assets: the Go side validates the tenant and serves them from the data dir.
	handle /themes/* {
		reverse_proxy 127.0.0.1:8081 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# SSO entry point: must intercept before the SPA fallback below.
	handle @sso {
		reverse_proxy 127.0.0.1:8081 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Content-hashed build output: the filename changes whenever the bytes do,
	# so it can be cached indefinitely.
	@immutable path /_nuxt/*
	handle @immutable {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /app/public
		file_server
	}

	handle {
		# frame-ancestors only counts on the framed document, which Caddy serves, not Go.
		# Block-scoped (site level double-adds CSP); no script-src (index.html is inline).
		header Content-Security-Policy "frame-ancestors {$GFTP_FRAME_ANCESTORS:'none'}"
		# Mirrors the headers the Go binary sets on its own responses.
		header X-Content-Type-Options "nosniff"
		header Referrer-Policy "no-referrer"
		header Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# index.html names the hashed chunks: a cached copy points at files that are gone
		# after an upgrade, i.e. a white screen rather than an old but working app.
		header Cache-Control "no-cache"

		root * /app/public
		try_files {path} /index.html
		file_server
	}
}
