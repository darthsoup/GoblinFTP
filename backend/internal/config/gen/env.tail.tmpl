# ── Dev & testing (hand-maintained tail) ──────────────────────────────────────
# GFTP_VERSION pins the docker-compose.prod.yml image tag; GFTP_DEV_PROXY is the
# vite proxy target; the NUXT_PUBLIC_SENTRY_* vars are baked into the SPA at
# build time, unlike GFTP_* which is read at process start (see docs/sentry.md).
#GFTP_VERSION=
#GFTP_DEV_PROXY=http://localhost:8080
#NUXT_PUBLIC_SENTRY_DSN=
#NUXT_PUBLIC_SENTRY_ENVIRONMENT=
#NUXT_PUBLIC_SENTRY_RELEASE=
#NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Integration-test gates and test-server credentials (compose profile "testing").
#GFTP_TEST_FTP_HOST=localhost:21
#GFTP_TEST_FTPS_HOST=localhost:2121
#GFTP_TEST_SFTP_HOST=localhost:2222
#GFTP_TEST_S3_ENDPOINT=http://localhost:9000
#FTP_USER=ftpuser
#FTP_PASS=ftppass
#SFTP_USER=ftpuser
#SFTP_PASS=ftppass
#PUBLIC_IP=127.0.0.1

# MinIO test-server root credentials, deliberately separate from GFTP_S3_*.
#MINIO_ROOT_USER=minioadmin
#MINIO_ROOT_PASSWORD=minioadmin
#MINIO_TEST_BUCKET=gftp-chunks
